# Local demo configuration. Experiment seed is configured per run (default 42).
# Public/simulated data only. Copy to .env; never commit secrets.
FEDCONSENT_DATA_DIR=./data
FEDCONSENT_ARTIFACT_DIR=./artifacts
FEDCONSENT_DATABASE_URL=sqlite:///./data/fedconsent.db
FEDCONSENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
